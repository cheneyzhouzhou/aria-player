build/
.build/
DerivedData/
*.xcuserstate

# Xcode user state — personal window layouts, breakpoints, scheme selections
xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# Local device configuration — never commit your device identifier
.device-udid

# Generated
demo-library/

# The app icon source and the compiled .icns are tracked on purpose: CI builds
# the macOS bundle from a fresh checkout, and without them it would fall back to
# the placeholder drawn by Tools/MakeIcon.swift instead of the real artwork.

.DS_Store
